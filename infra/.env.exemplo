# Copie para infra/.env e troque todos os valores. Nunca versione o .env (segredos ficam em cofre).
ORACLE_SENHA_ADMIN=TroqueEstaSenha_Admin1
NEXT_DB_SENHA=TroqueEstaSenha_Cfg1
NEXT_AUDIT_DB_SENHA=TroqueEstaSenha_Aud1
# Segredo HS256 compartilhado entre BFF e módulo (mínimo 32 bytes)
NEXT_TOKEN_INTERNO_SEGREDO=troque-por-um-segredo-aleatorio-com-mais-de-32-bytes
# Carga de dados fictícios no primeiro start (true em homologação/treinamento; false em produção)
NEXT_DEMO_CARREGAR=true
# demo | http (API do Portfólio da SUBTI, quando disponível)
NEXT_PORTFOLIO_MODO=demo
NEXT_PORTFOLIO_URL=
# dev (usuários fictícios) | oidc (gov.br - pendente)
NEXT_AUTH_MODO=dev
# true quando publicado atrás de HTTPS (cookie Secure)
NEXT_COOKIE_SECURE=false
